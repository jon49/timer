<script>
    import { formatClock, getAlarm, playAlarm } from "./shared/alarm.js"
    import { timerStore } from "./shared/data-store.js"
    import { onTick, offTick } from "./shared/tick-coordinator.js"
    import { formatTime } from "./shared/utils.js"
    import TimerSettings from "./TimerSettings.xht"

    export let id

    const limits = { hours: 23, minutes: 59, seconds: 59 }

    let timer = timerStore.getTimer(id)
    let state = "stopped"
    let timeLeft = 0
    let alarmTitle = ""
    let showSettings = false
    let clock
    let audio
    let timeout = 0
    let autoStop = 0
    let stopAudio = () => {}

    $onDestroy(clear)

    function update(patch) {
        timer = { ...timer, ...patch }
        timerStore.updateTimer(timer)
    }

    function setTime(e) {
        let input = e.target
        let name = input.name
        let value = +input.value
        if (Number.isInteger(value) && value >= 0 && value <= limits[name]) {
            update({ [name]: value })
        }
        input.value = formatTime(timer[name])
    }

    function clear() {
        offTick(id)
        clearTimeout(timeout)
        clearTimeout(autoStop)
        stopAudio()
        stopAudio = () => {}
    }

    // Also restarts a running or ringing timer.
    function start() {
        clear()
        let begin = Math.floor(Date.now() / 1e3)
        let total = timerStore.getTotalTime(id)
        timeLeft = total
        state = "running"
        onTick(id, now => {
            timeLeft = total - (now - begin)
        })
        timeout = setTimeout(ring, total * 1e3)
    }

    function stop() {
        clear()
        state = "stopped"
    }

    function ring() {
        clear()
        state = "alarm"
        clock.focus()
        let sound = getAlarm(timer.sound, timerStore.data.allowedSounds)
        if (sound) {
            alarmTitle = sound.title
            stopAudio = playAlarm(audio, sound)
            // Stop the alarm after 2 minutes.
            autoStop = setTimeout(stop, 12e4)
        }
    }

    function toggle() {
        if (state === "stopped") start()
        else stop()
    }
</script>

<header class="pb-0">
    <fieldset role="group">
        <input id={"timerTitle" + id} class="plain" @change={update({ title: $event.target.value })}
            value={timer.title} name="title" type="text" placeholder="Title">
        <label for={"timerTitle" + id} aria-label="Timer Title">&#9998;</label>
    </fieldset>
</header>

<fieldset role="group" @change={setTime}>
    <input value={formatTime(timer.hours)} name="hours" type="number" placeholder="h">
    <input value={formatTime(timer.minutes)} name="minutes" type="number" placeholder="m">
    <input value={formatTime(timer.seconds)} name="seconds" type="number" placeholder="s">
</fieldset>

<div class="flex justify-between">
    <div class="flex">
        <button #clock @click={toggle} style="width: 140px;"
            title={state === "alarm" ? alarmTitle : "Click to stop."}
            aria-label={state === "running" ? "Click to stop." : "Click to start."}
        >{state === "alarm" ? "Stop" : state === "stopped" ? "Start" : formatClock(timeLeft)}</button>
        <span hidden><audio #audio loop></audio></span>
        <button @click={start} hidden={state === "stopped"} aria-label="Restart">&#8635;</button>
        <button @click={showSettings = true} aria-label="Timer options">&#9881;</button>
        <button @click={clear(), $emit("delete")} aria-label="Delete timer">❌</button>
    </div>
</div>

{#if showSettings}
<TimerSettings sound={timer.sound} @sound={update({ sound: $event.detail })} @close={showSettings = false} />
{/if}
