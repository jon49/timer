<script>
    import { timerStore } from "./shared/data-store.js"
    import { downloadData, uploadData } from "./shared/data-transfer.js"
    import GlobalSettings from "./GlobalSettings.xht"
    import Timer from "./Timer.xht"

    let timerIds = timerStore.timerIds

    function addTimer() {
        timerIds = [...timerIds, timerStore.newTimer().id]
    }

    function removeTimer(id) {
        timerStore.deleteTimer(id)
        timerIds = timerIds.filter(x => x !== id)
    }
</script>

<header>
    <nav>
        <ul>
            <li class="pb-0 pt-0">
                <h1 class="m-0">
                    <img @click={addTimer} class="pointer" src="images/timer.svg" alt="Timer Hourglass logo"
                        style="height: 2em; width: 1.56em;">
                </h1>
            </li>
        </ul>
        <ul>
            <li><button class="theme-toggle" aria-label="Toggle theme" title="Toggle theme"></button></li>
            <li><button @click={addTimer}>Add Timer</button></li>
            <li><GlobalSettings /></li>
            <li><button @click={downloadData()} aria-label="Download timer data" title="Download timer data">&#11015;</button></li>
            <li><button @click={uploadData()} aria-label="Upload timer data" title="Upload timer data">&#11014;</button></li>
        </ul>
    </nav>
</header>

<main id="timer">
    <section class="grid timer-cards">
        {#each timerIds as id (id)}
            <article><Timer {id} @delete={removeTimer(id)} /></article>
        {/each}
    </section>
</main>

<footer>
    <a href="https://github.com/jon49/timer/tree/master/src/malinajs">Source Code</a>
    <br>
    <small>Created with <a href="https://malinajs.github.io/docs/">Malina.js</a></small>
    <br>
    <small>Created with <a href="https://www.freesoundeffects.com/">Sounds</a>.</small>
</footer>
