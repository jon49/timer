<script>
    // A native modal <dialog>: shown when it mounts, its `close` event
    // forwarded to the parent. Clicking the backdrop closes it.
    let dialog

    function click(e) {
        if (e.target.closest("[data-box]")) return
        dialog.close()
    }
</script>

<dialog #dialog @click={click} @@close {* $tick(() => dialog.showModal())}>
    <slot />
    <form id="modalClose" class="inline" method="dialog"></form>
</dialog>
