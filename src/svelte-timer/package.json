{
  "name": "svelte-timer",
  "version": "1.0.0",
  "description": "Timer implementation using Svelte 5",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "vite",
    "build": "npm run check && vite build --emptyOutDir --outDir ../../dist/svelte --base /svelte/",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "author": "Jon Nyman",
  "license": "ISC",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tsconfig/svelte": "^5.0.9",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-compression2": "^2.5.4"
  }
}
